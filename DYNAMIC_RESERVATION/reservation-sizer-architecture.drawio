        <mxCell id="A1" value="&lt;b&gt;Kit source (Git)&lt;/b&gt;&lt;br&gt;sizer · tests · manifests · CI guard" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#ffffff;strokeColor=#9aa0a6;" vertex="1" parent="A">
