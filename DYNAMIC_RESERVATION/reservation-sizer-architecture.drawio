        </mxCell>
        <mxCell id="N4" value="&lt;b&gt;PVC: history cache&lt;/b&gt;&lt;br&gt;10Gi standard-rwo&lt;br&gt;one file per UTC day" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#ffffff;strokeColor=#34a853;" vertex="1" parent="NS">
