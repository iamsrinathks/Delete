  <diagram id="logic" name="2 Daily run logic">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1320" pageHeight="1580" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="One daily run: from data to a pull request" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="20" y="14" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Exit codes: 0 OK · 2 fail-safe · 3 hold · 4 configuration · 5 PR failed. Exits 2–5 fail the Job at once." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="20" y="44" width="1000" height="24" as="geometry" />
        </mxCell>
        <mxCell id="R0" value="Daily Job starts (06:17 UTC)" style="ellipse;shape=ellipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#e8f0fe;strokeColor=#4285f4;" vertex="1" parent="1">
          <mxGeometry x="420" y="84" width="200" height="44" as="geometry" />
        </mxCell>
        <mxCell id="R1" value="&lt;b&gt;Load policy and settings&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#ffffff;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="350" y="156" width="340" height="44" as="geometry" />
        </mxCell>
        <mxCell id="X1" value="&lt;b&gt;exit 4&lt;/b&gt;&lt;br&gt;configuration error" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#fce8e6;strokeColor=#d93025;" vertex="1" parent="1">
          <mxGeometry x="770" y="156" width="300" height="44" as="geometry" />
        </mxCell>
        <mxCell id="R2" value="&lt;b&gt;Lock the history cache (PVC)&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#ffffff;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="350" y="228" width="340" height="44" as="geometry" />
        </mxCell>
        <mxCell id="X2" value="&lt;b&gt;exit 2&lt;/b&gt;&lt;br&gt;another run holds the lock" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#fce8e6;strokeColor=#d93025;" vertex="1" parent="1">
          <mxGeometry x="770" y="228" width="300" height="44" as="geometry" />
        </mxCell>
        <mxCell id="R3" value="&lt;b&gt;Read history&lt;/b&gt;&lt;br&gt;cached days + 1 new day: Monitoring, Logging, GKE operations" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#ffffff;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="350" y="300" width="340" height="56" as="geometry" />
        </mxCell>
        <mxCell id="Q1" value="Data complete?&lt;br&gt;(coverage ≥ 90 %)" style="rhombus;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#ffffff;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="420" y="384" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="X3" value="&lt;b&gt;exit 2 · fail-safe&lt;/b&gt;&lt;br&gt;nothing written" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#fce8e6;strokeColor=#d93025;" vertex="1" parent="1">
          <mxGeometry x="770" y="406" width="300" height="46" as="geometry" />
        </mxCell>
        <mxCell id="R4" value="&lt;b&gt;Read live state&lt;/b&gt;&lt;br&gt;node pools · reservations · tfvars file in GitHub" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#ffffff;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="350" y="502" width="340" height="56" as="geometry" />
        </mxCell>
        <mxCell id="Q2" value="Live count above&lt;br&gt;the branch? (DRIFT)" style="rhombus;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#ffffff;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="420" y="586" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="X4" value="&lt;b&gt;exit 3 · hold every key&lt;/b&gt;&lt;br&gt;close the open bot PR, write nothing" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#fef7e0;strokeColor=#f29900;" vertex="1" parent="1">
          <mxGeometry x="770" y="606" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="R5" value="&lt;b&gt;For each key (zone × machine type)&lt;/b&gt;&lt;br&gt;target = Σ ceil(peak excl. upgrades × 1.10) + largest maxSurge + stock-out add" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#ffffff;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="290" y="704" width="460" height="64" as="geometry" />
        </mxCell>
        <mxCell id="Q3" value="Key held?&lt;br&gt;(apply pending,&lt;br&gt;missing, not READY)" style="rhombus;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#ffffff;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="420" y="788" width="200" height="96" as="geometry" />
        </mxCell>
        <mxCell id="X5" value="&lt;b&gt;Keep the branch value for this key&lt;/b&gt;&lt;br&gt;PENDING_APPLY · NOT_FOUND · NOT_READY&lt;br&gt;exit 3 at the end; other keys continue" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#fef7e0;strokeColor=#f29900;" vertex="1" parent="1">
          <mxGeometry x="770" y="804" width="300" height="64" as="geometry" />
        </mxCell>
        <mxCell id="Q4" value="target&lt;br&gt;vs current" style="rhombus;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#ffffff;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="420" y="912" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="O1" value="&lt;b&gt;INCREASE&lt;/b&gt;&lt;br&gt;+ min(target − current, 3)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#e6f4ea;strokeColor=#188038;" vertex="1" parent="1">
          <mxGeometry x="160" y="1040" width="220" height="56" as="geometry" />
        </mxCell>
        <mxCell id="O2" value="&lt;b&gt;OK&lt;/b&gt;&lt;br&gt;no change" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#ffffff;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="420" y="1040" width="200" height="56" as="geometry" />
        </mxCell>
        <mxCell id="O3" value="&lt;b&gt;COULD_REDUCE&lt;/b&gt;&lt;br&gt;advisory only: in the report and&lt;br&gt;PR body, never written" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#fef7e0;strokeColor=#f29900;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="660" y="1040" width="260" height="64" as="geometry" />
        </mxCell>
        <mxCell id="NT" value="&lt;b&gt;No automatic downsize today&lt;/b&gt;&lt;br&gt;• COULD_REDUCE is only a message.&lt;br&gt;• The CI guard fails a decrease in a bot PR.&lt;br&gt;• A person can decrease a count in a human PR;&lt;br&gt;&amp;nbsp;&amp;nbsp;the guard only warns.&lt;br&gt;• After a stock-out, the hold message gives&lt;br&gt;&amp;nbsp;&amp;nbsp;step_back_to; a person opens that PR." style="shape=note;size=14;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#fffde7;strokeColor=#f29900;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="960" y="1016" width="330" height="112" as="geometry" />
        </mxCell>
        <mxCell id="J" value="&lt;b&gt;Write report.json and the 'sizer result' log line&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#ffffff;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="350" y="1160" width="340" height="44" as="geometry" />
        </mxCell>
        <mxCell id="Q5" value="Mode?" style="rhombus;shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#ffffff;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="445" y="1232" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="M1" value="&lt;b&gt;report&lt;/b&gt;&lt;br&gt;no GitHub writes" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#ffffff;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="150" y="1246" width="220" height="52" as="geometry" />
        </mxCell>
        <mxCell id="M2" value="&lt;b&gt;dry-run&lt;/b&gt;&lt;br&gt;draft PR &quot;[DRY RUN]&quot;&lt;br&gt;the guard fails it" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#ffffff;strokeColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="420" y="1350" width="200" height="64" as="geometry" />
        </mxCell>
        <mxCell id="M3" value="&lt;b&gt;live&lt;/b&gt;&lt;br&gt;open or update the PR&lt;br&gt;close stale bot PRs" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#ffffff;strokeColor=#5f6368;" vertex="1" parent="1">
