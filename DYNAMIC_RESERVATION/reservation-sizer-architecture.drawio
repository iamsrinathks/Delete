        <mxCell id="t1" value="Reservation Sizer (kit v1.4): how it is built, deployed and run" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="20" y="14" width="1200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="One CronJob in each GKE cluster (3 projects · 6 regional clusters · 2 regions). It runs each day and only grows reservations: a decrease is advisory and is never written." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#5f6368;" vertex="1" parent="1">
          <mxGeometry x="20" y="44" width="1500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="A" value="Build and release (each kit version)" style="rounded=1;arcSize=2;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;whiteSpace=wrap;html=1;fontColor=#202124;fillColor=#f8f9fa;strokeColor=#9aa0a6;" vertex="1" parent="1">
