          <mxGeometry x="20" y="120" width="440" height="400" as="geometry" />
        </mxCell>
        <mxCell id="N1" value="&lt;b&gt;CronJob reservation-sizer&lt;/b&gt;&lt;br&gt;daily 06:17 UTC · concurrencyPolicy Forbid · podFailurePolicy" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#ffffff;strokeColor=#34a853;" vertex="1" parent="NS">
          <mxGeometry x="20" y="45" width="400" height="56" as="geometry" />
        </mxCell>
        <mxCell id="N2" value="&lt;b&gt;Job → Pod: sizer container&lt;/b&gt;&lt;br&gt;user 10001 · read-only root file system · 60 min limit&lt;br&gt;computes targets, writes the report and the PR" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#e6f4ea;strokeColor=#188038;strokeWidth=2;" vertex="1" parent="NS">
