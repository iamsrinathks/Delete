          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eA4" value="render + commit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;fontColor=#3c4043;endArrow=block;endFill=1;strokeColor=#5f6368;labelBackgroundColor=#ffffff;jumpStyle=arc;jumpSize=8;" edge="1" parent="1" source="A4" target="A5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="L" value="&lt;b&gt;Daily run&lt;/b&gt;&lt;br&gt;1&amp;nbsp; CronJob starts a Job at 06:17 UTC&lt;br&gt;2&amp;nbsp; Pod gets a Google token (Workload Identity)&lt;br&gt;3&amp;nbsp; Reads history: cached days + 1 new day&lt;br&gt;4&amp;nbsp; Reads live state: node pools, reservations&lt;br&gt;5&amp;nbsp; Reads the PAT and the tfvars file (GitHub)&lt;br&gt;6&amp;nbsp; Dry-run / live: pushes a branch, opens a PR&lt;br&gt;7&amp;nbsp; CI guard and speculative plan check the PR&lt;br&gt;8&amp;nbsp; A code owner approves and merges&lt;br&gt;9&amp;nbsp; HCP Terraform applies the new count&lt;br&gt;10 Next run sees OK, or a hold if apply failed&lt;br&gt;&lt;br&gt;&lt;b&gt;Colours&lt;/b&gt;&lt;br&gt;green = Kubernetes · blue = Google Cloud&lt;br&gt;amber = reservation count · purple = Terraform" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#ffffff;strokeColor=#9aa0a6;fontColor=#202124;" vertex="1" parent="1">
          <mxGeometry x="20" y="630" width="300" height="225" as="geometry" />
        </mxCell>
        <mxCell id="B" value="Google Cloud project (×3, one per environment) · the sizer has read-only access" style="rounded=1;arcSize=2;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;whiteSpace=wrap;html=1;fontColor=#202124;fillColor=#e8f0fe;strokeColor=#4285f4;" vertex="1" parent="1">
          <mxGeometry x="350" y="90" width="930" height="740" as="geometry" />
        </mxCell>
        <mxCell id="B1" value="GKE regional cluster (6 in total)" style="rounded=1;arcSize=2;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;whiteSpace=wrap;html=1;fontColor=#202124;fillColor=#e6f4ea;strokeColor=#34a853;" vertex="1" parent="B">
          <mxGeometry x="20" y="40" width="480" height="660" as="geometry" />
        </mxCell>
        <mxCell id="B1a" value="&lt;b&gt;Config Sync (ACM)&lt;/b&gt;&lt;br&gt;applies Git state, reverts edits" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fontSize=11;fontColor=#202124;fillColor=#ffffff;strokeColor=#34a853;" vertex="1" parent="B1">
